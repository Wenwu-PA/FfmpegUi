{
  "name": "ffmpeg-studio",
  "version": "0.2.2",
  "private": true,
  "description": "Local desktop media conversion with FFmpeg",
  "author": {
    "name": "Wenwu-PA"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "npm run build && electron-builder --win nsis portable",
    "start": "electron .",
    "lint": "eslint . && stylelint \"src/renderer/**/*.css\"",
    "format": "prettier --write .",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "electron-store": "^8.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.10",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  }
}
